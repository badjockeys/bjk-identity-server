<Project>
  <!-- Central package management: versions live here, projects reference packages without a Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the pins below override versions that dependencies pull in. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bad Jockeys modules, from GitHub Packages (bjk-modules). -->
    <PackageVersion Include="BJK.Modules.User" Version="0.2.0-ci.121" />
    <PackageVersion Include="BJK.Modules.Email" Version="0.2.0-ci.121" />
    <PackageVersion Include="BJK.Modules.SMS" Version="0.2.0-ci.121" />

    <PackageVersion Include="Duende.IdentityServer.AspNetIdentity" Version="8.0.9" />
    <PackageVersion Include="Duende.IdentityServer.EntityFramework" Version="8.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />

    <!-- Social sign-in. Each provider is only switched on when its keys are configured. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.13" />
    <PackageVersion Include="AspNet.Security.OAuth.Apple" Version="10.0.0" />

    <!-- Age check: YuNet face detection for the liveness check (OpenCV Zoo model, run with ONNX Runtime). -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />

    <!-- Tests. xUnit v3 runs on Microsoft Testing Platform (opted in via global.json). -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />

    <!-- QR codes for setting up an authenticator app. -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />

    <!-- Security pins for packages we only get indirectly. Remove once dependencies ship the fix themselves. -->
    <!-- CVE-2026-70162 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx): fixed in 10.0.13. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
