<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Bad Jockeys modules (bjk-modules). Needs credentials: see docs/local-development.md. -->
    <add key="badjockeys" value="https://nuget.pkg.github.com/badjockeys/index.json" />
  </packageSources>

  <!-- BJK.* only ever comes from our feed; everything else only from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="badjockeys">
      <package pattern="BJK.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
