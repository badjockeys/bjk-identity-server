# Copy to .env (git-ignored) and choose your own passwords.
# SQL Server needs 8+ characters with upper case, lower case, a digit and a symbol.
BJK_SQL_PASSWORD=Choose-A-Str0ng-Password

# Any password; it goes in Messaging:ConnectionUri in your user secrets (here and in bjk-core).
BJK_RABBITMQ_PASSWORD=Choose-A-Password
