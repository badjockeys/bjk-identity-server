@page
@model IndexModel
@{
    ViewData["Title"] = "Your account";
}
<h1>Your account</h1>
@if (TempData["Notice"] is string notice)
{
    <p class="notice ok">@notice</p>
}
<dl>
    <dt>Email</dt>
    <dd>@Model.Email @(Model.EmailConfirmed ? "(confirmed)" : "(not confirmed)")</dd>
    <dt>Two-step</dt>
    <dd>@(Model.TwoFactorEnabled ? "On" : "Off")</dd>
    <dt>Mobile number</dt>
    <dd>@(Model.MobileNumber ?? "Not added")</dd>
    <dt>Sensitive posts</dt>
    <dd>@(Model.UnderAgeByDateOfBirth && Model.AgeCheckStatus != BJK.Modules.User.Domain.AgeCheckStatus.Passed ? "For adults only (18 and over)" : Model.AgeCheckStatus switch
    {
        BJK.Modules.User.Domain.AgeCheckStatus.Passed => "Age verified: you can view them",
        BJK.Modules.User.Domain.AgeCheckStatus.DocumentRequired => "Photo ID needed",
        BJK.Modules.User.Domain.AgeCheckStatus.Failed => "Not passed",
        _ => "Not done yet",
    })</dd>
    @if (Model.Roles.Count > 0)
    {
        <dt>Role</dt>
        <dd>@string.Join(", ", Model.Roles)</dd>
    }
</dl>

@if (!Model.EmailConfirmed)
{
    <form method="post" asp-page-handler="SendConfirmation">
        <button type="submit" class="secondary">Send the confirmation email again</button>
    </form>
}

<div class="links">
    @if (Model.AgeCheckStatus != BJK.Modules.User.Domain.AgeCheckStatus.Passed && !Model.UnderAgeByDateOfBirth)
    {
        <a asp-page="/Account/CheckAge" asp-route-returnUrl="/Manage">Verify your age to view sensitive posts</a>
    }
    <a asp-page="./TwoFactor">Two-step verification</a>
    <a asp-page="./MobileNumber">Mobile number</a>
    <a asp-page="./ChangePassword">@(Model.HasPassword ? "Change password" : "Set a password")</a>
    <a asp-page="./ExternalLogins">Google, Apple and Facebook sign-in</a>
    <a asp-page="./Deactivate">Deactivate my account</a>
    <a asp-page="/Account/Logout">Sign out</a>
</div>
