@page
@model ChangePasswordModel
@{
    ViewData["Title"] = Model.HasPassword ? "Change password" : "Set a password";
}
<h1>@(Model.HasPassword ? "Change password" : "Set a password")</h1>
@if (!Model.HasPassword)
{
    <p class="lead">You sign in with Google, Apple or Facebook. Add a password to sign in with your email too.</p>
}
<form method="post">
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    @if (Model.HasPassword)
    {
        <label asp-for="Input.CurrentPassword">Current password</label>
        <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" />
    }
    <label asp-for="Input.NewPassword">New password</label>
    <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
    <label asp-for="Input.ConfirmPassword">Confirm new password</label>
    <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
    <button type="submit">Save</button>
</form>
<div class="links"><a asp-page="./Index">Back to your account</a></div>
