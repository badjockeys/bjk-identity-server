<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@(ViewData["Title"] is string title ? $"{title} · Bad Jockeys" : "Bad Jockeys")</title>
    <style>
        :root {
            --bg: #f4f4f1; --card: #ffffff; --ink: #18181b; --muted: #5f5f66; --line: #dcdcd6;
            --accent: #f5c400; --accent-ink: #18181b; --danger: #b42318; --ok: #146c2e; --focus: #2b59c3;
        }
        @@media (prefers-color-scheme: dark) {
            :root { --bg: #121214; --card: #1c1c20; --ink: #f2f2f0; --muted: #a5a5ad; --line: #34343a; --danger: #ff8a7a; --ok: #7ee2a1; --focus: #8fb0ff; }
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
        header { padding: 18px 16px; text-align: center; }
        header a { color: var(--ink); text-decoration: none; font-weight: 800; letter-spacing: .02em; font-size: 20px; }
        header a span { background: var(--accent); color: var(--accent-ink); padding: 0 6px; border-radius: 4px; margin-left: 4px; }
        main { max-width: 440px; margin: 0 auto 48px; padding: 0 16px; }
        .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 24px; }
        h1 { font-size: 22px; margin: 0 0 6px; }
        p.lead { color: var(--muted); margin: 0 0 18px; }
        label { display: block; font-weight: 600; margin: 14px 0 6px; }
        input[type=email], input[type=password], input[type=text] {
            width: 100%; padding: 11px 12px; border: 1px solid var(--line); border-radius: 8px;
            background: var(--bg); color: var(--ink); font-size: 16px;
        }
        input:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
        .check { display: flex; gap: 8px; align-items: center; margin: 14px 0 0; font-weight: 400; }
        button, .button {
            display: inline-block; width: 100%; margin-top: 18px; padding: 12px 14px; border: 0; border-radius: 8px;
            background: var(--accent); color: var(--accent-ink); font-size: 16px; font-weight: 700; cursor: pointer; text-align: center; text-decoration: none;
        }
        button.secondary, .button.secondary { background: transparent; color: var(--ink); border: 1px solid var(--line); }
        button.danger { background: var(--danger); color: #fff; }
        .providers { display: grid; gap: 8px; margin-top: 8px; }
        .providers button { margin-top: 0; }
        .divider { display: flex; align-items: center; gap: 10px; color: var(--muted); margin: 20px 0 4px; font-size: 14px; }
        .divider::before, .divider::after { content: ""; flex: 1; border-top: 1px solid var(--line); }
        .links { margin-top: 18px; display: grid; gap: 6px; font-size: 15px; }
        a { color: var(--focus); }
        .error, .validation-summary-errors, .field-validation-error { color: var(--danger); }
        .validation-summary-errors ul { margin: 12px 0 0; padding-left: 18px; }
        .notice { padding: 12px; border-radius: 8px; border: 1px solid var(--line); margin: 0 0 16px; }
        .notice.ok { border-color: var(--ok); color: var(--ok); }
        .codes { font-family: ui-monospace, Menlo, monospace; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 12px; border: 1px dashed var(--line); border-radius: 8px; }
        .qr { background: #fff; padding: 12px; border-radius: 8px; width: fit-content; margin: 12px auto; }
        .qr svg { display: block; width: 200px; height: 200px; }
        .key { font-family: ui-monospace, Menlo, monospace; word-break: break-all; }
        dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; margin: 0; }
        dt { color: var(--muted); }
        dd { margin: 0; }
        fieldset.dob { border: 0; padding: 0; margin: 14px 0 0; min-width: 0; }
        fieldset.dob legend { font-weight: 600; padding: 0; }
        .hint { color: var(--muted); font-size: 15px; margin: 2px 0 0; }
        .dob-boxes { display: flex; gap: 12px; }
        .dob-boxes label { font-weight: 400; margin: 8px 0 4px; }
        .dob-boxes input { padding: 11px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); font-size: 16px; }
        .dob-boxes input.dob-2 { width: 4.2em; }
        .dob-boxes input.dob-4 { width: 6em; }
        .dob-boxes input[aria-invalid=true] { border-color: var(--danger); }
        footer { text-align: center; color: var(--muted); font-size: 13px; padding-bottom: 24px; }
    </style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header><a href="/">Bad <span>Jockeys</span></a></header>
    <main>
        <div class="card">
            @RenderBody()
        </div>
    </main>
    <footer>Bad Jockeys accounts</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
