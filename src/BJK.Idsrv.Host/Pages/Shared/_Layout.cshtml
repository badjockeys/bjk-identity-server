<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@(ViewData["Title"] is string title ? $"{title} · Bad Jockeys" : "Bad Jockeys")</title>
    <style>
        /*
         * The web app's brand theme (bjk-core src/web/src/app/globals.css), so these pages look like part of it: black
         * and white base, cyan #00B5E5 buttons with white text, Poppins, light mode only.
         */
        @@font-face { font-family: Poppins; font-style: normal; font-weight: 400; font-display: swap; src: url("/fonts/poppins-latin-400.woff2") format("woff2"); }
        @@font-face { font-family: Poppins; font-style: normal; font-weight: 500; font-display: swap; src: url("/fonts/poppins-latin-500.woff2") format("woff2"); }
        @@font-face { font-family: Poppins; font-style: normal; font-weight: 600; font-display: swap; src: url("/fonts/poppins-latin-600.woff2") format("woff2"); }
        :root {
            --ink: #111111; --muted: #5f5f66; --line: #d9d9d4; --soft: #f4f4f1; --card: #ffffff;
            --brand: #00b5e5; --brand-tint: #e6f7fc; --brand-tint-text: #00607f;
            --danger: #a11a12; --ok: #146c2e;
            --font: Poppins, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            color-scheme: light;
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--soft); color: var(--ink); font: 15px/1.45 var(--font); }
        header { padding: 22px 16px 18px; text-align: center; }
        header a { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 20px; }
        main { max-width: 440px; margin: 0 auto 48px; padding: 0 16px; }
        .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
        h1 { font-size: 22px; font-weight: 600; margin: 0 0 6px; }
        h2 { font-size: 17px; font-weight: 600; }
        p.lead { color: var(--muted); margin: 0 0 18px; }
        label { display: block; font-weight: 500; margin: 14px 0 6px; }
        input[type=email], input[type=password], input[type=text] {
            width: 100%; height: 44px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px;
            background: #ffffff; color: var(--ink); font: 15px var(--font);
        }
        input:focus, .dob-boxes input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-tint); }
        button:focus-visible, a:focus-visible { outline: 3px solid var(--brand); outline-offset: 2px; }
        input[type=checkbox] { accent-color: var(--brand); width: 18px; height: 18px; }
        .check { display: flex; gap: 8px; align-items: center; margin: 14px 0 0; font-weight: 400; }
        button, .button {
            display: inline-flex; align-items: center; justify-content: center; width: 100%; height: 44px; margin-top: 18px;
            padding: 0 18px; border: 1px solid var(--brand); border-radius: 22px; background: var(--brand); color: #ffffff;
            font: 600 15px var(--font); cursor: pointer; text-decoration: none;
        }
        button.secondary, .button.secondary { background: #ffffff; color: var(--ink); border-color: var(--line); }
        button.danger { background: var(--danger); border-color: var(--danger); color: #ffffff; }
        button:disabled { opacity: .55; cursor: not-allowed; }
        .providers { display: grid; gap: 8px; margin-top: 8px; }
        .providers button { margin-top: 0; background: #ffffff; color: var(--ink); border-color: var(--line); }
        .divider { display: flex; align-items: center; gap: 10px; color: var(--muted); margin: 20px 0 4px; font-size: 14px; }
        .divider::before, .divider::after { content: ""; flex: 1; border-top: 1px solid var(--line); }
        .links { margin-top: 18px; display: grid; gap: 6px; font-size: 15px; }
        a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
        .error, .validation-summary-errors, .field-validation-error { color: var(--danger); }
        .validation-summary-errors ul { margin: 12px 0 0; padding-left: 18px; }
        .notice { padding: 12px; border-radius: 10px; border: 1px solid var(--line); margin: 0 0 16px; }
        .notice.ok { border-color: var(--brand); background: var(--brand-tint); color: var(--brand-tint-text); }
        .codes { font-family: ui-monospace, Menlo, monospace; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 12px; border: 1px dashed var(--line); border-radius: 10px; }
        .qr { background: #fff; padding: 12px; border-radius: 10px; width: fit-content; margin: 12px auto; }
        .qr svg { display: block; width: 200px; height: 200px; }
        .key { font-family: ui-monospace, Menlo, monospace; word-break: break-all; }
        dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; margin: 0; }
        dt { color: var(--muted); }
        dd { margin: 0; }
        fieldset.dob { border: 0; padding: 0; margin: 14px 0 0; min-width: 0; }
        fieldset.dob legend { font-weight: 500; padding: 0; }
        .hint { color: var(--muted); font-size: 14px; margin: 2px 0 0; }
        .dob-boxes { display: flex; gap: 12px; }
        .dob-boxes label { font-weight: 400; margin: 8px 0 4px; }
        .dob-boxes input { height: 44px; padding: 0 12px; border: 1px solid var(--line); border-radius: 10px; background: #ffffff; color: var(--ink); font: 15px var(--font); }
        .dob-boxes input.dob-2 { width: 4.2em; }
        .dob-boxes input.dob-4 { width: 6em; }
        .dob-boxes input[aria-invalid=true] { border-color: var(--danger); }
        footer { text-align: center; color: var(--muted); font-size: 13px; padding-bottom: 24px; }
    </style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header>
        <a href="/">
            <svg width="30" height="30" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
                <path d="M10 34 V18 Q10 10 18 10 H34 M66 10 H82 Q90 10 90 18 V34 M90 66 V82 Q90 90 82 90 H66 M34 90 H18 Q10 90 10 82 V66"
                      fill="none" stroke="#111111" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="50" cy="50" r="19" fill="#00B5E5" />
            </svg>
            Bad Jockeys
        </a>
    </header>
    <main>
        <div class="card">
            @RenderBody()
        </div>
    </main>
    <footer>Bad Jockeys accounts</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
