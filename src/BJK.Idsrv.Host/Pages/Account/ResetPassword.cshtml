@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
@if (Model.Done)
{
    <h1>Password changed</h1>
    <p class="lead">You can sign in with your new password now.</p>
    <a class="button" asp-page="./Login">Sign in</a>
}
else
{
    <h1>Choose a new password</h1>
    <form method="post">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <input type="hidden" asp-for="Input.Email" />
        <input type="hidden" asp-for="Input.Token" />
        <label asp-for="Input.NewPassword">New password</label>
        <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" autofocus />
        <label asp-for="Input.ConfirmPassword">Confirm new password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        <button type="submit">Change password</button>
    </form>
}
