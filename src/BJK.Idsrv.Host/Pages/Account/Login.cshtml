@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<p class="lead">Welcome back.</p>

<form method="post">
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" type="email" autocomplete="username" autofocus />

    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" type="password" autocomplete="current-password" />

    <label class="check"><input asp-for="Input.RememberMe" type="checkbox" /> Keep me signed in</label>

    <button type="submit">Sign in</button>
</form>

<partial name="_ExternalProviders" model="new ExternalProvidersModel(Model.Providers, Model.ReturnUrl)" />

<div class="links">
    <a asp-page="./ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Forgotten your password?</a>
    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">New here? Create an account</a>
    <a asp-page="./Reactivate" asp-route-returnUrl="@Model.ReturnUrl">Deactivated your account? Reactivate it</a>
</div>
