@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgotten password";
}
@if (Model.Sent)
{
    <h1>Check your email</h1>
    <p class="lead">If there's an account for that address, we've sent a link to reset the password.</p>
    <a class="button secondary" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a>
}
else
{
    <h1>Forgotten your password?</h1>
    <p class="lead">Enter your email and we'll send you a link to choose a new one.</p>
    <form method="post">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" autocomplete="email" autofocus />
        <partial name="_Turnstile" />
        <button type="submit">Send link</button>
    </form>
}
