{
  "ConnectionStrings": {
    "IdentityDatabase": "Server=localhost,1433;Database=idsrv;User Id=sa;Password=<BJK_SQL_PASSWORD from your .env>;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Messaging": "Server=localhost,1433;Database=badjockeys;User Id=sa;Password=<BJK_SQL_PASSWORD from your .env>;TrustServerCertificate=True"
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@badjockeys.local",
    "PublicOrigin": "https://localhost:5001",
    "PasswordResetUrl": "https://localhost:5001/Account/ResetPassword",
    "SendGrid": { "ApiKey": "<only if Provider is SendGrid: a key with the Mail Send permission>" }
  },

  "Captcha": {
    "TurnstileSecretKey": "1x0000000000000000000000000000000AA",
    "TurnstileSiteKey": "1x00000000000000000000AA"
  },
  "Messaging": {
    "//": "User lifecycle events go into bjk-core's queue tables in the badjockeys database (ConnectionStrings:Messaging). In Azure that connection uses a login allowed only to read messaging.subscriptions and add rows to the messaging tables. bjk-core creates the tables, so this host never does.",
    "ConnectionStringName": "Messaging",
    "CreateTables": false
  },
  "Clients": {
    "Web": {
      "RedirectUris": [ "http://localhost:3000/api/auth/callback/bjk" ],
      "PostLogoutRedirectUris": [ "http://localhost:3000/" ],
      "Secret": "local-web-secret"
    },
    "Mobile": {
      "RedirectUris": [ "badjockeys://auth/callback" ],
      "PostLogoutRedirectUris": [ "badjockeys://auth/signed-out" ]
    },
    "Backoffice": {
      "RedirectUris": [ "http://localhost:3001/api/auth/callback/bjk" ],
      "PostLogoutRedirectUris": [ "http://localhost:3001/" ],
      "Secret": "local-backoffice-secret"
    }
  },
  "SignUp": {
    "AllowedCountries": [ "GB" ],
    "TrustCloudflareCountryHeader": false,
    "DevelopmentCountry": ""
  },
  "AgeAssurance": {
    "//": "The on-demand age check for sensitive posts (not part of sign-up): liveness against spoofing, then the face age estimate, with photo ID as the fallback.",
    "ChallengeAge": 25,
    "MaxAttemptsPerDay": 3,
    "Liveness": {
      "Provider": "Development",
      "Development": { "Pass": true },
      "YuNet": { "ModelPath": "<only if Provider is YuNet: path to face_detection_yunet_2023mar.onnx>", "FfmpegPath": "ffmpeg" }
    },
    "Estimator": {
      "Provider": "Development",
      "Development": { "Age": 30 },
      "Http": {
        "Name": "<only if Provider is Http: the vendor's name>",
        "ApiKey": "<only if Provider is Http: secret>",
        "ApiKeyHeader": "Authorization",
        "ApiKeyPrefix": "Bearer ",
        "AgePath": "age"
      }
    },
    "Document": {
      "Provider": "Development",
      "Development": { "Age": 30 }
    }
  },
  "Admin": {
    "BootstrapEmails": [ "<your email, once you've registered and confirmed it>" ]
  },
  "Authentication": {
    "Google": { "ClientId": "", "ClientSecret": "" },
    "Apple": { "ClientId": "", "TeamId": "", "KeyId": "", "PrivateKey": "" },
    "Facebook": { "AppId": "", "AppSecret": "" }
  }
}
